          ]
        },
        { "id": "wait.image_generate", "while": "imageBusy" },
        { "id": "image.review" },
        { "id": "done.export", "legacyStepKey": "done" }
      ]
    },
    "concept_image_direct": {
      "id": "concept_image_direct",
      "label": "Concept / Image / Direct",
      "description": "Path 2 structure + 概念助手 — fused violet setup like product direct; product photo optional",
      "priority": "P1",
      "basedOn": "product_image_direct",
      "context": {
        "workflowMode": "image-only",
        "promotionMode": "concept",
        "intakePath": "direct"
      },
      "steps": [
        { "id": "entry.start" },
        { "id": "route.output_goal", "set": { "workflowMode": "image-only" } },
        { "id": "route.subject", "set": { "promotionMode": "concept" } },
        {
          "id": "identity.concept",
          "label": "概念助手（非實體產品）",
          "required": ["conceptIdea"]
        },
        { "id": "route.intake", "set": { "intakePath": "direct" } },
        {
          "id": "setup.pre_generate",
          "label": "Pre-generate setup",
          "handler": "generateImage",
          "skippable": false,
          "note": "創作方向 + optional ref + copy + optional product photo + generate",
          "fuses": [
            "route.primary_style",
            "asset.reference_image",
            "wait.reference_analyze",
            "copy.edit",
            "asset.brand_website",
            "image.output_format",
            "asset.product_photo",
            "image.options",
            "image.generate"
          ]
        },
        { "id": "wait.image_generate", "while": "imageBusy" },
        { "id": "image.review" },
        { "id": "done.export", "legacyStepKey": "done" }
      ]
    },
    "product_video_research_reel": {
      "id": "product_video_research_reel",
      "label": "Product / Video / Research reel",
      "priority": "P1",
      "context": {
        "promotionMode": "physical",
        "intakePath": "research"
      },
      "variants": [
        {
          "when": { "workflowMode": "combined" },
          "setAfterAngle": { "visualStyleId": "storyboard-video" },
          "stepsSuffix": ["image.storyboard_scenes", "wait.storyboard_generate"]
        },
        {
          "when": { "workflowMode": "video-only" },
          "setAfterAngle": { "visualStyleId": "product" },
          "stepsSuffix": []
        }
      ],
      "steps": [
        { "id": "entry.start" },
        { "id": "route.output_goal", "required": true },
        { "id": "route.subject", "set": { "promotionMode": "physical" } },
        { "id": "identity.product_name", "required": ["product"] },
        { "id": "route.intake", "set": { "intakePath": "research" } },
        { "id": "research.platform", "skippable": true },
        {
          "id": "research.pick_angle",
          "handler": "applyContentAngleToWizard",
          "expectFormat": "reel",
          "skippable": true,
          "skipWhen": "referenceAd && referenceIsVideo"
        },
        { "id": "wait.research_apply", "skipWhen": "!contentResearchApplyRef" },
        {
          "id": "asset.reference_video",
          "label": "參考短片（已由研究帶入則自動跳過）",
          "required": false,
          "alwaysVisible": true,
          "accepts": ["searchDownload", "manualUpload"],
          "skipWhen": "combinedNoReel",
          "note": "Always skipped — research reels attach MP4 on angle apply; analyze on wait.reel_*; manual MP4 on setup.pre_video"
        },
        {
          "id": "wait.reel_download",
          "when": "researchReelDownloadBusy",
          "while": "researchReelDownloadBusy",
          "onFailure": {
            "actions": ["research.pick_angle", "asset.reference_video"],
            "messageKey": "contentResearch.videoDownloadFailed"
          }
        },
        {
          "id": "wait.reel_analyze",
          "while": "researchReelAnalyzeBusy",
          "skipWhen": "!referenceIsVideo"
        },
        {
          "id": "setup.pre_video",
          "label": "Pre-video setup",
          "handler": "generateVideo",
          "skippable": false,
          "when": "workflowMode === 'video-only'",
          "note": "Video-only research → fused violet setup like image research",
          "fuses": [
            "copy.edit",
            "asset.product_photo",
            "video.settings",
            "video.generate"
          ]
        },
        {
          "id": "setup.pre_generate",
          "label": "Pre-generate setup (combined storyboard)",
          "handler": "generateImage",
          "skippable": false,
          "when": "workflowMode === 'combined'",
          "note": "Combined research → fuse copy/photo/brief; CTA generates scene stills",
          "fuses": [
            "copy.edit",
            "asset.product_photo",
            "copy.storyboard_brief"
          ]
        },
        {
          "id": "wait.storyboard_generate",
          "when": "workflowMode === 'combined'"
        },
        {
          "id": "image.review",
          "when": "workflowMode === 'combined'"
        },
        {
          "id": "setup.pre_video",
          "label": "Pre-video setup (scenes ready)",
          "handler": "generateVideo",
          "skippable": false,
          "when": "workflowMode === 'combined'",
          "fuses": ["video.settings", "video.generate"]
        },
        { "id": "IMAGE_STORYBOARD_BRANCH" },
        { "id": "wait.video_generate", "while": "videoBusy" },
        { "id": "done.export", "legacyStepKey": "done" }
      ]
    },
    "product_video_direct": {
      "id": "product_video_direct",
