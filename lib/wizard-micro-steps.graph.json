          "skippable": false,
          "fuses": ["video.settings", "video.generate"]
        },
        { "id": "wait.video_generate", "while": "videoBusy" },
        { "id": "done.export" }
      ]
    },
    "concept_video_research_reel": {
      "id": "concept_video_research_reel",
      "label": "Concept / Video / Research reel",
      "description": "Path 8 — Path 5 + 概念助手; §9.5; 手動上傳 MP4 always visible",
      "priority": "P1",
      "pathNumber": 8,
