        },
        {
          "when": { "workflowMode": "video-only" },
          "setAfterAngle": { "visualStyleId": "product" },
          "stepsSuffix": []
        }
      ],
      "steps": [
        { "id": "entry.start" },
        { "id": "route.output_goal", "required": true },
        { "id": "route.subject", "set": { "promotionMode": "concept" } },
        {
          "id": "identity.concept",
          "label": "概念助手（非實體產品）",
          "required": ["conceptIdea"]
        },
        { "id": "route.intake", "set": { "intakePath": "research" } },
        {
          "id": "research.platform",
          "promoteTarget": "wizardPromoteName({ promotionMode: 'concept', conceptIdea, headline, product })",
          "skippable": true
        },
        {
          "id": "research.pick_angle",
          "handler": "applyContentAngleToWizard",
